# 下の設定は npm 11.16 以降でしか効かない。古い npm では黙って無視されるため engines と対にして弾く
engine-strict=true

# 依存の install script は既定で拒否する
strict-allow-scripts=true

# git 依存は package.json に書いたものだけ許可する（npm 12 の既定は none）
allow-git=root

# npm/cli#9800 の回避。直ったら消す
# npm v11 では、allが規定
allow-remote=all

# 公開直後の版は入れない
min-release-age=3

# renovate を導入しているため基本 skip する
audit=false

fund=false

scope=tremolo-ui

init-author-email=contact.m1m0zzz@gmail.com
init-author-name=mimoz
init-author-url=https://m1m0zzz.github.io/
init-license= UNLICENSED
init-version=0.0.0
