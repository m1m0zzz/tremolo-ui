{
  "name": "@tremolo-ui/svelte",
  "version": "0.7.0",
  "description": "Svelte component library for audio app",
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "sb": "storybook dev",
    "build:sb": "storybook build -o storybook-static/i/storybook-svelte && cp .storybook/_headers storybook-static/_headers",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:package": "svelte-check --tsconfig ./tsconfig.json && svelte-package -i src -o dist",
    "clean": "npm run clean:build && npm run clean:sb",
    "clean:build": "rimraf ./dist",
    "clean:sb": "rimraf ./storybook-static"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-svelte-csf": "5.1.3",
    "@storybook/svelte-vite": "10.6.0",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "svelte": "5.57.1",
    "storybook": "10.6.0",
    "svelte-check": "4.7.6"
  },
  "peerDependencies": {
    "svelte": "^5.40.0"
  },
  "dependencies": {
    "@tremolo-ui/dom": "^0.7.0",
    "@tremolo-ui/functions": "^0.7.0",
    "esm-env": "^1.2.2"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "mimoz",
    "email": "contact.m1m0zzz@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/m1m0zzz/tremolo-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m1m0zzz/tremolo-ui.git",
    "directory": "packages/svelte"
  },
  "keywords": [
    "svelte",
    "svelte-components",
    "ui",
    "components",
    "web-audio"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
