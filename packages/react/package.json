{
  "name": "@tremolo-ui/react",
  "version": "0.5.0",
  "description": "React component library for audio app",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.cts",
  "scripts": {
    "sb": "storybook dev -p 6006",
    "typecheck": "tsc",
    "build:sb": "storybook build",
    "serve": "http-server ./storybook-static",
    "lint": "eslint --fix --ext .ts,.tsx .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:package": "tsc && tsdown",
    "clean": "npm run clean:build && npm run clean:sb",
    "clean:build": "rimraf ./dist",
    "clean:sb": "rimraf ./storybook-static"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-links": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jotai": "2.20.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.6.0",
    "tone": "15.1.22"
  },
  "peerDependencies": {
    "react": "^18 ||^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@tremolo-ui/dom": "^0.5.0",
    "@tremolo-ui/functions": "^0.5.0"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.{ts,tsx}",
    "!src/**/*.stories.{ts,tsx}"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "mimoz",
    "email": "contact.m1m0zzz@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/m1m0zzz/tremolo-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m1m0zzz/tremolo-ui.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "react-components",
    "ui",
    "components",
    "web-audio"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
