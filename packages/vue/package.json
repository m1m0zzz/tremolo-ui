{
  "name": "@tremolo-ui/vue",
  "version": "0.7.0",
  "description": "Vue component library for audio app",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.cts",
  "scripts": {
    "sb": "storybook dev",
    "build:sb": "storybook build -o storybook-static/i/storybook-vue && cp .storybook/_headers storybook-static/_headers",
    "typecheck": "tsc && vue-tsc --noEmit -p ../../site/examples/vue/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:package": "npm run typecheck && tsdown",
    "clean": "npm run clean:build && npm run clean:sb",
    "clean:build": "rimraf ./dist",
    "clean:sb": "rimraf ./storybook-static"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/vue3-vite": "10.6.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/vue": "8.1.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "esbuild": "0.28.1",
    "storybook": "10.6.0",
    "vue-tsc": "3.3.11",
    "vue": "3.5.43"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@tremolo-ui/dom": "^0.7.0",
    "@tremolo-ui/functions": "^0.7.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "mimoz",
    "email": "contact.m1m0zzz@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/m1m0zzz/tremolo-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m1m0zzz/tremolo-ui.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "vue",
    "vue-components",
    "ui",
    "components",
    "web-audio"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
